---
import Layout from '../layouts/Layout.astro';
import Shield from '../components/Icons/Shield.astro';
import WhatsApp from '../components/Icons/WhatsApp.astro';
import Clock from '../components/Icons/Clock.astro';
import CheckCircle from '../components/Icons/CheckCircle.astro';
import Chat from '../components/Icons/Chat.astro';
import Tunder from '../components/Icons/Tunder.astro';
import Phone from '../components/Icons/Phone.astro';

const whatsappNumber = '5491140230671';
const whatsappMessage = encodeURIComponent("Hola! Quiero encender mi maquina de ventas. Hablemos.");
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${whatsappMessage}`;

const benefits = [
  { icon: 'Clock', text: 'Respuesta en minutos' },
  { icon: 'CheckCircle', text: 'Diagnóstico exprés sin cargo' },
  { icon: 'Shield', text: 'Sin compromiso. Transparencia total' },
];

const stats = [
  { value: '<1s', sub: 'de carga', label: 'Velocidad que convierte' },
  { value: '24/7', sub: 'activo', label: 'Tu web nunca duerme' },
  { value: '+50', sub: 'clientes', label: 'Confían en nosotros' },
];

const processSteps = [
  {
    step: '01',
    title: 'Analizamos tu negocio',
    description: 'Una charla directa por WhatsApp. Nos contás tu idea y te devolvemos un diagnóstico técnico sin vueltas.',
    icon: 'Chat',
  },
  {
    step: '02',
    title: 'Diseñamos tu máquina',
    description: 'Arquitectura de conversión a medida: velocidad, tracking, automatización. Tu negocio listo para escalar.',
    icon: 'Zap',
  },
  {
    step: '03',
    title: 'Encendemos y facturás',
    description: 'Deploy en vivo. Tu web empieza a recibir tráfico y a convertir visitas en clientes desde el día uno.',
    icon: 'CheckCircle',
  },
];

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contacto Directo | Tu Máquina de Ventas",
  "description": "Canal de comunicación directa por WhatsApp para ingeniería de software y desarrollo web.",
  "mainEntity": {
    "@type": "ContactPoint",
    "telephone": "+" + whatsappNumber,
    "contactType": "Ventas e Ingeniería",
    "availableLanguage": "Spanish"
  }
};
---

<Layout title="Contacto - Prendé tu Infraestructura Digital">
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />

  <main>
    <!-- HERO SECTION -->
    <section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-8 md:pt-20">
      


      <div class="absolute inset-0 opacity-[0.02] pointer-events-none" 
           style="background-image: repeating-linear-gradient(45deg, transparent, transparent 25px, rgba(34,197,94,0.04) 25px, rgba(34,197,94,0.04) 26px)" aria-hidden="true"></div>

      <div class="container relative z-10 mx-auto px-4 md:px-6 py-20">
        <div class="max-w-5xl mx-auto text-center">
          
          <div class="inline-flex items-center gap-2 rounded-full bg-green-500/10 border border-green-500/25 px-5 py-2.5 mb-8 shadow-[0_0_20px_rgba(34,197,94,0.1)] animate-fade-in">
            <span class="relative flex h-2 w-2">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-green-400"></span>
            </span>
            <span class="text-xs font-black text-green-400 uppercase tracking-[0.25em]">Online ahora · Respondemos al toque</span>
          </div>

          <h1 id="contact-title" class="text-5xl md:text-8xl font-black mb-6 leading-[0.9] tracking-tighter animate-fade-in-up delay-100 text-white">
            Prendé tu <br class="hidden md:block"/>
            <span class="text-gradient">Infraestructura Digital</span>
          </h1>

          <p class="text-base md:text-xl text-gray-400 mb-14 max-w-2xl mx-auto animate-fade-in-up delay-200">
            Sin formularios, sin demoras. Una conversación directa por WhatsApp y arrancamos.
          </p>

          <div class="mb-14 animate-scale-in delay-300">
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative inline-flex items-center gap-4 rounded-2xl bg-gradient-to-r from-[#25d366] via-[#1db954] to-[#16a34a] px-8 md:px-12 py-6 text-white font-black text-lg md:text-xl shadow-lg shadow-green-500/30 hover:shadow-green-500/50 hover:scale-[1.04] active:scale-95 transition-all duration-300 overflow-hidden border border-green-400/20"
            >
              <div class="absolute inset-0 bg-[linear-gradient(60deg,transparent,rgba(255,255,255,0.12),transparent)] opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
              <span class="relative z-10"><WhatsApp size="28" /></span>
              <div class="relative z-10 text-left">
                  <span class="block text-xl md:text-2xl font-black uppercase tracking-tight">Encender mi Proyecto</span>
                  <span class="block text-xs md:text-start text-center text-green-100/60 font-bold uppercase tracking-[0.25em]">Chat directo · Sin vueltas · Respuesta inmediata</span>
              </div>
            </a>
          </div>

          <div class="flex flex-wrap justify-center gap-8 mb-16 animate-fade-in-up delay-400">
            {benefits.map((benefit) => (
              <div class="flex items-center gap-2.5 text-gray-400 group">
                <span class="inline-flex items-center justify-center w-7 h-7 rounded-md bg-green-500/10 border border-green-500/20 group-hover:bg-green-500/20 transition-colors">
                  {benefit.icon === 'Clock' && <Clock size="16" color="#22c55e" />}
                  {benefit.icon === 'CheckCircle' && <CheckCircle size="16" color="#22c55e" />}
                  {benefit.icon === 'Shield' && <Shield size="18" color="#22c55e"/>}
                </span>
                <span class="text-sm font-bold text-gray-300 tracking-tight">{benefit.text}</span>
              </div>
            ))}
          </div>

          <dl class="grid md:grid-cols-3 gap-4 max-w-3xl mx-auto">
            {stats.map((stat, index) => (
              <div class="relative rounded-2xl border border-white/10 bg-gradient-to-b from-white/[0.03] to-transparent backdrop-blur-sm text-center py-6 md:py-8 px-4 group hover:border-green-500/30 hover:shadow-[0_0_30px_rgba(34,197,94,0.06)] transition-all duration-500 overflow-hidden">
                <div class="absolute top-0 right-0 w-12 h-12 pointer-events-none overflow-hidden opacity-0 group-hover:opacity-100 transition-opacity duration-500">
                  <div class="absolute top-0 right-0 w-[70px] h-[1.5px] origin-top-right rotate-45 translate-x-1/2 bg-green-500/40"></div>
                </div>
                <dt class="text-[9px] md:text-[10px] text-gray-600 uppercase tracking-[0.25em] mb-2 font-bold">{stat.label}</dt>
                <dd class="flex items-baseline justify-center gap-1">
                  <span class="text-4xl md:text-5xl font-black text-green-400 drop-shadow-[0_0_10px_rgba(34,197,94,0.2)]">{stat.value}</span>
                  <span class="text-[10px] text-gray-600 uppercase tracking-wide font-bold">{stat.sub}</span>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </div>
    </section>

    <!-- PROCESS SECTION -->
    <section class="relative py-20 md:py-32 border-t border-white/[0.04] overflow-hidden" data-animate-section>
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute top-1/3 left-1/4 w-[400px] h-[400px] bg-cyan-500/5 rounded-full blur-[120px]"></div>
      </div>
      <div class="absolute inset-0 opacity-[0.015] pointer-events-none" 
           style="background-image: repeating-linear-gradient(-45deg, transparent, transparent 25px, rgba(0,255,255,0.03) 25px, rgba(0,255,255,0.03) 26px)"></div>

      <div class="container mx-auto px-4 md:px-6 relative z-10">
        <header class="text-center mb-16 process-header">
          <div class="inline-flex items-center gap-2 rounded-full bg-cyan-500/10 border border-cyan-500/20 px-4 py-1.5 mb-5">
            <span class="relative flex h-1.5 w-1.5">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-cyan-400"></span>
            </span>
            <span class="text-[9px] font-black text-cyan-400 uppercase tracking-[0.25em]">Cómo funciona</span>
          </div>
          <h2 class="text-4xl md:text-6xl font-black text-white tracking-tight leading-[0.95]">
            De la idea al <span class="text-gradient">deploy en vivo</span>
          </h2>
          <p class="text-gray-500 text-sm md:text-base mt-4 max-w-xl mx-auto">Tres pasos. Sin burocracia. Sin videollamadas eternas.</p>
        </header>

        <div class="grid md:grid-cols-3 gap-5 md:gap-4 max-w-5xl mx-auto">
          {processSteps.map((item, index) => (
            <article 
              class="process-card relative rounded-[1.5rem] md:rounded-[2rem] border-2 border-white/[0.06] bg-gradient-to-b from-white/[0.02] to-transparent p-7 md:p-8 group hover:border-cyan-500/40 hover:shadow-[0_0_40px_rgba(0,255,255,0.06)] transition-all duration-500 overflow-hidden backdrop-blur-sm" 
              data-index={index}
            >
              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700" 
                   style="background: radial-gradient(500px circle at 50% 50%, rgba(0,255,255,0.08), transparent 60%)"></div>

              <div class="absolute top-0 right-0 w-16 h-16 pointer-events-none overflow-hidden">
                <div class="absolute top-0 right-0 w-[90px] h-[1.5px] origin-top-right rotate-45 translate-x-1/2 bg-cyan-500/20 group-hover:bg-cyan-500/40 transition-colors duration-500"></div>
              </div>

              <div class="relative z-10">
                <div class="flex items-center gap-4 mb-5">
                  <span class="inline-flex items-center justify-center text-[10px] font-black text-cyan-400 bg-cyan-500/10 border border-cyan-500/20 rounded-lg px-2.5 py-1 tracking-wider group-hover:bg-cyan-500/20 group-hover:shadow-[0_0_10px_rgba(0,255,255,0.1)] transition-all duration-300">
                    {item.step}
                  </span>
                  <div class="h-px flex-1 bg-gradient-to-r from-cyan-500/20 to-transparent"></div>
                </div>
                
                <div class="flex h-11 w-11 items-center justify-center rounded-xl bg-white/[0.03] border border-white/[0.06] mb-5 group-hover:scale-110 group-hover:border-cyan-500/30 group-hover:bg-cyan-500/10 transition-all duration-300">
                  {item.icon === 'Chat' && <Chat />}
                  {item.icon === 'Zap' && <Tunder />}
                  {item.icon === 'CheckCircle' && <CheckCircle color="#22c55e"/>}
                </div>

                <h3 class="text-lg md:text-xl font-black text-white mb-3 tracking-tight uppercase">{item.title}</h3>
                <p class="text-gray-400 text-sm leading-relaxed">{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="relative py-16 md:py-28 border-t border-white/[0.04] overflow-hidden" data-animate-section>
      <div class="absolute inset-0 pointer-events-none">
        <div class="absolute bottom-1/2 left-1/2 -translate-x-1/2 translate-y-1/2 w-[600px] h-[600px] bg-green-500/8 rounded-full blur-[150px]"></div>
      </div>
      <div class="absolute inset-0 opacity-[0.02] pointer-events-none" 
           style="background-image: repeating-linear-gradient(45deg, transparent, transparent 25px, rgba(34,197,94,0.03) 25px, rgba(34,197,94,0.03) 26px)"></div>

      <div class="container mx-auto px-4 md:px-6 relative z-10">
        <div class="final-cta relative rounded-[2rem] md:rounded-[3rem] border-2 border-green-500/20 bg-gradient-to-b from-green-900/10 to-[#08080c] p-8 md:p-14 text-center max-w-3xl mx-auto overflow-hidden group hover:border-green-500/30 hover:shadow-[0_0_60px_rgba(34,197,94,0.08)] transition-all duration-700">
          
          <div class="absolute inset-0 opacity-[0.03] pointer-events-none" 
               style="background-image: repeating-linear-gradient(-45deg, transparent, transparent 25px, rgba(34,197,94,0.04) 25px, rgba(34,197,94,0.04) 26px)"></div>

          <div class="absolute top-0 right-0 w-20 h-20 pointer-events-none overflow-hidden">
            <div class="absolute top-0 right-0 w-[110px] h-[2px] origin-top-right rotate-45 translate-x-1/2 bg-green-500/30"></div>
          </div>
          
          <div class="relative z-10">
            <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-green-500/10 border-2 border-green-500/20 mx-auto mb-6 group-hover:scale-110 group-hover:shadow-[0_0_30px_rgba(34,197,94,0.15)] transition-all duration-500">
              <Phone color="#22c55e" />
            </div>

            <h2 class="text-3xl md:text-6xl font-black mb-4 text-white tracking-tight leading-[0.95]">
              ¿Listo para <span class="text-green-400 drop-shadow-[0_0_15px_rgba(34,197,94,0.3)]">facturar</span>?
            </h2>
            <p class="text-gray-400 text-sm md:text-base mb-10 max-w-md mx-auto">
              Cada día sin una web optimizada es plata que deja tu negocio. Escribinos ahora.
            </p>
            
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="group/btn relative inline-flex items-center gap-3 rounded-2xl bg-gradient-to-r from-[#25d366] via-[#1db954] to-[#16a34a] px-10 py-5 text-white font-black text-sm md:text-base uppercase tracking-wider hover:scale-[1.04] active:scale-95 transition-all duration-300 shadow-lg shadow-green-500/25 hover:shadow-green-500/50 overflow-hidden border border-green-400/20"
            >
              <div class="absolute inset-0 bg-[linear-gradient(60deg,transparent,rgba(255,255,255,0.12),transparent)] opacity-0 group-hover/btn:opacity-100 transition-opacity duration-500"></div>
              <span class="relative z-10"><WhatsApp size="24" /></span>
              <span class="relative z-10">CHATEAR AHORA</span>
            </a>
            
            <p class="text-[9px] text-gray-600 mt-6 uppercase tracking-[0.25em] font-bold">
              Sin formularios · Sin demoras · Atención humana real
            </p>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .process-header, .process-card, .final-cta {
    opacity: 0;
    transform: translateY(30px);
    transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity;
  }

  .process-card[data-index="0"] { transition-delay: 0s; }
  .process-card[data-index="1"] { transition-delay: 0.15s; }
  .process-card[data-index="2"] { transition-delay: 0.3s; }

  .is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .text-gradient {
    background: linear-gradient(to right, #00E5FF, #a855f7);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  #contact-title {
    animation: fadeIn 0.8s ease-out forwards;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .process-header, .process-card, .final-cta {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const initObserver = () => {
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
        }
      });
    }, { 
      threshold: 0.1,
      rootMargin: '0px 0px -50px 0px' 
    });

    const animatedSelectors = ['.process-header', '.process-card', '.final-cta'];
    animatedSelectors.forEach(selector => {
      document.querySelectorAll(selector).forEach(el => observer.observe(el));
    });
  };

  document.addEventListener('DOMContentLoaded', initObserver);
  document.addEventListener('astro:page-load', initObserver);
</script>
