---
import Layout from '../layouts/Layout.astro';
import ShieldCheck from '../components/Icons/ShieldCheck.astro';

const WHATSAPP_NUMBER = "5491140230671"; 

const plans = [
  {
    id: 'impulse',
    name: 'Impulse',
    price: '$150', 
    priceUsd: '$150',
    period: 'Setup inicial + $60/mes',
    description: 'Validación profesional inmediata. Landing de alto impacto, ultrarrápida y optimizada para conversiones.',
    icon: 'rocket',
    accentColor: '#00ffff',
    buttonText: 'Lanzar Ahora',
    features: [
      'Landing Page de Carga Instantánea',
      'Optimización Mobile-First Real',
      'Canal Directo WhatsApp/Telegram',
      'Ficha Google Business (Local SEO)',
      'Hosting de Alta Disponibilidad',
      'Certificado SSL & Seguridad Web',
    ],
    notIncluded: ['Automatización de Leads (n8n)', 'Integración de IA (RAG)', 'Sistemas de Datos'],
    promotion: false
  },
  {
    id: 'authority',
    name: 'Authority',
    price: '$599',
    priceUsd: '$599',
    period: 'Setup inicial + $120/mes',
    description: 'Para negocios que buscan automatizar y escalar. Arquitectura de conversión y automatización de flujos.',
    icon: 'sparkles',
    popular: true,
    accentColor: '#a855f7',
    buttonText: 'Dominar mi Mercado',
    features: [
      'Ecosistema Web de hasta 6 Secciones',
      'Optimización AEO (Answer Engine)',
      'Formularios con Lógica de Venta',
      'Automatización de Leads (n8n/Webhooks)',
      'SEO Técnico Avanzado',
      'Setup de Tracking de Conversiones',
      'Mantenimiento y Soporte Mensual',
    ],
    notIncluded: ['Agentes de IA Autónomos (RAG)', 'Desarrollo Full-Stack a Medida'],
  },
  {
    id: 'enterprise',
    name: 'Enterprise',
    price: '$1,999',
    priceUsd: '$1,999',
    period: 'Setup inicial + $350/mes',
    description: 'Potencia full-stack con arquitectura personalizada, base de datos vectorial y soporte dedicado.',
    icon: 'code',
    accentColor: '#f59e0b',
    buttonText: 'Ver Disponibilidad',
    features: [
      'Desarrollo Full-Stack a Medida',
      'Base de Datos Vectorial (RAG-ready)',
      'Automatización Avanzada con n8n',
      'SEO Técnico y AEO Completo',
      'Dashboard Administrativo',
      'Integraciones API Ilimitadas',
      'Soporte Prioritario 24/7',
    ],
    notIncluded: ['Agentes de IA Autónomos', 'Infraestructura Zero-Trust', 'SLA de Nivel Enterprise'],
    projectUrl: 'https://app.canchalibre.pro',
    projectLabel: 'Caso real: canchalibre.pro',
  },
  {
    id: 'titan',
    name: 'Titan',
    price: 'A Medida',
    priceUsd: 'Custom',
    period: 'Desde $4,500 + Retainer',
    description: 'Poder tecnológico absoluto. Infraestructura a medida y motores de IA para empresas que dominan con datos.',
    icon: 'crown',
    premium: true,
    accentColor: '#d4a017',
    buttonText: 'Solicitar Consultoría',
    features: [
      'Desarrollo Full-Stack Exclusivo',
      'Bases de Datos Vectoriales de Alta Performance',
      'Integración de IA Autónoma (RAG)',
      'Panel Administrativo y Dashboards',
      'Infraestructura Zero-Trust',
      'Tracking Server-side (Privacy-first)',
      'SLA de Soporte Prioritario',
    ],
    notIncluded: [],
  },
];

const pricingSchema = {
  "@context": "https://schema.org",
  "@type": "OfferCatalog",
  "name": "Planes de Ingeniería Digital 2026",
  "plans": plans.map(p => ({ id: p.id, description: p.description })),
  "itemListElement": plans.map((plan, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Offer",
      "name": plan.name,
      "description": plan.description,
      "priceCurrency": "USD",
      "price": plan.priceUsd.replace('$', '').replace(',', '')
    }
  }))
};
---

<Layout title="Planes y Precios | Ingeniería Web de Alto Rendimiento">
  <script type="application/ld+json" set:html={JSON.stringify(pricingSchema)} />

  <section class="relative pt-32 md:pt-48 pb-16 md:pb-20 overflow-hidden z-[50]" data-animate-section>
    <div class="absolute inset-0 pointer-events-none">
      <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-purple-600/10 rounded-full blur-[150px]"></div>
      <div class="absolute top-0 right-0 w-[400px] h-[400px] bg-cyan-500/5 rounded-full blur-[100px]"></div>
    </div>
    <div class="container mx-auto px-4 md:px-6 text-center relative">
      <span class="text-cyan-400 font-bold uppercase tracking-[0.3em] text-[10px] md:text-xs mb-4 block animate-on-scroll" data-animation="fade-in-down">
        MODELOS DE ESCALABILIDAD
      </span>
      <h1 class="text-5xl md:text-8xl font-black mb-6 tracking-tighter text-white animate-on-scroll leading-[0.9]" data-animation="fade-in-up" data-delay="100">
        Deja de gastar,<br/>
        <span class="text-gradient text-6xl md:text-9xl">empezá a facturar</span>
      </h1>
      <p class="text-base md:text-xl text-gray-400 max-w-2xl mx-auto animate-on-scroll px-2" data-animation="fade-in-up" data-delay="200">
        Desde lanzamientos rápidos hasta ecosistemas de ingeniería con IA. 
        Elegí la infraestructura que llevará tu facturación al siguiente nivel.
      </p>
    </div>
  </section>

  <section class="relative pb-16 md:pb-24 z-[50]" data-animate-section>
    <div class="absolute inset-0 pointer-events-none bg-radial-at-c opacity-30" aria-hidden="true"></div>

    <div class="container mx-auto px-4 md:px-6">
      <ul class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-4 max-w-7xl mx-auto list-none p-0 items-stretch" role="list">
        {plans.filter(p => p.id !== 'titan').map((plan, index) => (
          <li 
            id={`plan-${plan.id}`}
            data-color={plan.accentColor}
            class="relative flex flex-col animate-on-scroll plan-card-container scroll-mt-32 h-full cursor-pointer group/card" 
            data-animation="fade-in-up"
            data-delay={index * 120}
            onclick={`window.location.href='/plans/${plan.id}'`}
          >
            {plan.popular && (
              <div class="absolute -top-4 left-1/2 -translate-x-1/2 z-20 w-max">
                <span class="inline-flex items-center gap-1.5 rounded-full bg-gradient-to-r from-[#a855f7] via-[#c084fc] to-[#00E5FF] px-5 py-2 text-[10px] font-black text-white tracking-wide uppercase shadow-[0_0_30px_rgba(168,85,247,0.7)] border border-white/15 drop-shadow-[0_0_10px_rgba(168,85,247,0.3)]">
                  <svg class="w-3 h-3" viewBox="0 0 24 24" fill="currentColor"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
                  Más Elegido
                </span>
              </div>
            )}

            <article class={`plan-card h-full flex flex-col relative overflow-hidden rounded-[1.5rem] md:rounded-[2rem] border-2 transition-all duration-500 group ${
              plan.popular ? 'border-purple-500/50 shadow-[0_0_40px_rgba(168,85,247,0.2)] shadow-[inset_0_0_30px_rgba(168,85,247,0.05)]' : 
              plan.id === 'enterprise' ? 'border-amber-500/30 shadow-[0_0_30px_rgba(245,158,11,0.08)]' :
              'border-white/10'
            }`}>
              {/* Heavier background gradient */}
              <div class={`absolute inset-0 transition-opacity duration-500 ${
                plan.popular ? 'bg-gradient-to-br from-purple-900/25 via-[#08080c] to-[#08080c]' : 
                plan.id === 'enterprise' ? 'bg-gradient-to-br from-amber-900/15 via-[#08080c] to-[#08080c]' :
                'bg-gradient-to-br from-cyan-900/10 via-[#08080c] to-[#08080c]'
              }`}></div>

              {/* Diagonal tech pattern overlay */}
              <div class="absolute inset-0 opacity-[0.03] pointer-events-none" 
                   style="background-image: repeating-linear-gradient(45deg, transparent, transparent 20px, rgba(255,255,255,0.03) 20px, rgba(255,255,255,0.03) 21px)"></div>

              {/* Corner accent */}
              <div class={`absolute top-0 right-0 w-20 h-20 pointer-events-none overflow-hidden`}>
                <div class={`absolute top-0 right-0 w-[120px] h-[2px] origin-top-right rotate-45 translate-x-1/2 ${
                  plan.popular ? 'bg-purple-500/30' : plan.id === 'enterprise' ? 'bg-amber-500/30' : 'bg-white/10'
                }`}></div>
              </div>

              <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700" 
                   style={`background: radial-gradient(600px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), ${plan.accentColor}20, transparent 60%)`}></div>

              <div class="absolute -top-32 -right-32 w-64 h-64 opacity-[0.08] blur-[100px] rounded-full pointer-events-none transition-all duration-700 group-hover:opacity-30 group-hover:scale-150" 
                   style={{backgroundColor: plan.accentColor}} aria-hidden="true"></div>

              <div class="absolute -bottom-32 -left-32 w-48 h-48 opacity-[0.04] blur-[80px] rounded-full pointer-events-none group-hover:opacity-15 transition-all duration-700" 
                   style={{backgroundColor: plan.accentColor}} aria-hidden="true"></div>

              <div class="relative z-10 flex flex-col h-full p-5 md:p-6 lg:p-7">
                
                <div class="flex items-center justify-between mb-5">
                  <div class={`h-11 w-11 md:h-13 md:w-13 flex items-center justify-center rounded-xl transition-all duration-500 ${
                    plan.icon === 'rocket' ? 'bg-cyan-500/15 group-hover:bg-cyan-500/30 group-hover:shadow-[0_0_25px_rgba(0,255,255,0.3)] border border-cyan-500/20 group-hover:border-cyan-500/40' : 
                    plan.icon === 'sparkles' ? 'bg-purple-500/15 group-hover:bg-purple-500/30 group-hover:shadow-[0_0_25px_rgba(168,85,247,0.3)] border border-purple-500/20 group-hover:border-purple-500/40' : 
                    'bg-amber-500/15 group-hover:bg-amber-500/30 group-hover:shadow-[0_0_25px_rgba(245,158,11,0.3)] border border-amber-500/20 group-hover:border-amber-500/40'
                  }`} aria-hidden="true">
                    {plan.icon === 'rocket' && <svg class="text-cyan-400 h-5 w-5 md:h-6 md:w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.1 4-1 4-1"/><path d="M12 15v5s3.03-.55 4-2c1.1-1.62 1-4 1-4"/></svg>}
                    {plan.icon === 'sparkles' && <svg class="text-purple-400 h-5 w-5 md:h-6 md:w-6" viewBox="0 0 24 24" fill="currentColor"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>}
                    {plan.icon === 'code' && <svg class="text-amber-400 h-5 w-5 md:h-6 md:w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>}
                  </div>
                  <div class="text-[9px] md:text-[10px] font-mono uppercase tracking-wider text-gray-600">
                    {plan.id === 'impulse' ? 'Starter' : plan.id === 'authority' ? 'Recomendado' : 'Crecimiento'}
                  </div>
                </div>
                
                <h3 class="text-2xl md:text-3xl font-black text-white mb-1 tracking-tight">
                  <a href={`/plans/${plan.id}`} onclick="event.stopPropagation()" class="card-title-link inline-flex items-center gap-2 group-hover/card:underline group-hover/card:decoration-white/30 group-hover/card:underline-offset-4 transition-all duration-300">
                    {plan.name}
                    <svg class="w-4 h-4 opacity-0 -translate-x-1 group-hover/card:opacity-100 group-hover/card:translate-x-0 transition-all duration-300 ease-out" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M7 7h10v10M7 17L17 7"/></svg>
                  </a>
                </h3>

                <div class="flex items-baseline gap-px mb-0.5 mt-1">
                  <span class="text-[9px] md:text-[10px] text-gray-500 uppercase tracking-widest font-mono">USD</span>
                </div>
                <div class="flex flex-col mb-1">
                  <div class="flex items-baseline gap-2">
                    <span class={`text-5xl md:text-6xl font-black tracking-tighter leading-none ${
                      plan.id === 'authority' ? 'text-purple-400 drop-shadow-[0_0_15px_rgba(168,85,247,0.3)]' : 
                      plan.id === 'enterprise' ? 'text-amber-400 drop-shadow-[0_0_15px_rgba(245,158,11,0.3)]' : 
                      'text-white drop-shadow-[0_0_10px_rgba(255,255,255,0.1)]'
                    }`}>
                    {plan.priceUsd}
                    </span>
                  </div>
                </div>
                <p class="text-[10px] md:text-[11px] text-gray-600 uppercase tracking-wide mb-4 pb-4 border-b border-white/[0.07] font-bold">{plan.period}</p>
                
                <p class="text-gray-400 text-xs md:text-sm leading-relaxed mb-6">{plan.description}</p>

                {plan.projectUrl && (
                  <div class="relative mb-6 rounded-xl border border-amber-500/20 bg-gradient-to-br from-amber-900/10 via-[#08080c] to-[#08080c] overflow-hidden group/proj hover:border-amber-500/40 hover:shadow-[0_0_20px_rgba(245,158,11,0.08)] transition-all duration-500">
                    <div class="absolute top-0 right-0 w-12 h-12 pointer-events-none overflow-hidden">
                      <div class="absolute top-0 right-0 w-[65px] h-[1.5px] origin-top-right rotate-45 translate-x-1/2 bg-amber-500/30"></div>
                    </div>

                    <div class="flex items-start gap-3 p-3">
                      <div class="w-[72px] h-[52px] shrink-0 rounded-lg overflow-hidden bg-amber-500/10 border border-amber-500/10 flex items-center justify-center relative">
                        <img
                          src="/projects/canchalibre-card.webp"
                          alt="Canchalibre.pro"
                          class="w-full h-full object-cover absolute inset-0"
                          loading="lazy"
                          onerror="this.style.display='none'; this.nextElementSibling.style.display='flex'"
                        />
                        <div class="hidden w-full h-full items-center justify-center bg-gradient-to-br from-amber-900/20 to-amber-950/40 text-amber-500/60">
                          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5"><path d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                        </div>
                      </div>

                      <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-1.5 mb-0.5">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
                          <span class="text-[8px] font-bold text-amber-400/70 uppercase tracking-[0.2em]">Proyecto en vivo</span>
                        </div>
                        <a
                          href={plan.projectUrl}
                          target="_blank"
                          rel="noopener noreferrer"
                          onclick="event.stopPropagation()"
                          class="text-sm font-bold text-white hover:text-amber-400 transition-colors leading-tight block truncate"
                        >
                          {plan.projectLabel.replace('Caso real: ', '')}
                          <svg class="w-3 h-3 inline-block ml-1 opacity-60 group-hover/proj:opacity-100 group-hover/proj:translate-x-0.5 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M7 7h10v10M7 17L17 7"/></svg>
                        </a>
                        <p class="text-[9px] text-gray-500 leading-tight mt-0.5">Plataforma full-stack a medida</p>
                      </div>
                    </div>
                  </div>
                )}

                <ul class="space-y-2.5 mb-4 flex-grow list-none p-0" role="list">
                  {plan.features.map((feature) => (
                    <li class="flex items-start gap-3 group/feat">
                      <span class={`inline-flex items-center justify-center w-5 h-5 md:w-5 md:h-5 shrink-0 mt-0.5 rounded-sm ${
                        plan.popular ? 'bg-purple-500/15 text-purple-400 group-hover/feat:bg-purple-500/25' :
                        plan.id === 'enterprise' ? 'bg-amber-500/15 text-amber-400 group-hover/feat:bg-amber-500/25' :
                        'bg-cyan-500/15 text-cyan-400 group-hover/feat:bg-cyan-500/25'
                      } transition-colors duration-300`}>
                        <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                      </span>
                      <span class="text-xs md:text-sm text-gray-300 leading-tight group-hover/feat:text-white transition-colors duration-300">{feature}</span>
                    </li>
                  ))}
                  {plan.notIncluded.map((feature) => (
                    <li class="flex items-start gap-3 opacity-20 group/feat hover:opacity-30 transition-opacity duration-300">
                      <span class="inline-flex items-center justify-center w-5 h-5 shrink-0 mt-0.5 rounded-sm bg-gray-800 text-gray-600">
                        <svg class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M18 6 6 18"/></svg>
                      </span>
                      <span class="text-xs md:text-sm text-gray-600 line-through">{feature}</span>
                    </li>
                  ))}
                </ul>

                <a
                  href={`https://wa.me/${WHATSAPP_NUMBER}?text=Hola! Me interesa potenciar mi negocio con el Plan ${plan.name}.`}
                  target="_blank"
                  rel="noopener noreferrer"
                  onclick="event.stopPropagation()"
                  class={`plan-cta w-full flex items-center justify-center gap-2.5 py-4 px-6 rounded-xl font-black text-sm uppercase tracking-wider transition-all duration-300 transform relative overflow-hidden group/btn ${
                    plan.popular ? 'bg-gradient-to-r from-[#a855f7] via-[#c084fc] to-[#00E5FF] text-white shadow-lg shadow-purple-500/30 hover:shadow-purple-500/60 hover:scale-[1.04] active:scale-95 border border-purple-400/20' : 
                    plan.icon === 'code' ? 'bg-gradient-to-r from-amber-600 to-amber-500 text-white shadow-lg shadow-amber-500/25 hover:shadow-amber-500/50 hover:scale-[1.04] active:scale-95 border border-amber-400/20' :
                    'bg-gradient-to-r from-white/10 to-white/5 text-white border border-white/10 hover:from-cyan-500/20 hover:to-cyan-400/10 hover:border-cyan-400/30 hover:shadow-[0_0_30px_rgba(0,255,255,0.15)] hover:scale-[1.04] active:scale-95'
                  }`}
                >
                  <span class="relative z-10">{plan.buttonText}</span>
                  <svg class="relative z-10 h-4 w-4 group-hover/btn:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                  <div class={`absolute inset-0 opacity-0 group-hover/btn:opacity-100 transition-opacity duration-500 ${
                    plan.popular ? 'bg-[linear-gradient(60deg,transparent,rgba(255,255,255,0.1),transparent)]' :
                    'bg-[linear-gradient(60deg,transparent,rgba(255,255,255,0.06),transparent)]'
                  }`}></div>
                </a>
              </div>
            </article>
          </li>
        ))}
      </ul>

      <!-- SEPARADOR -->
      <div class="relative flex items-center gap-4 my-12 max-w-5xl mx-auto">
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-500/30 to-transparent"></div>
        <div class="flex items-center gap-2 text-yellow-500/60 text-[10px] font-bold uppercase tracking-[0.3em]">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
          Solución Máxima
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>
        </div>
        <div class="h-px flex-1 bg-gradient-to-r from-transparent via-yellow-500/30 to-transparent"></div>
      </div>

      <!-- TITAN - Full width horizontal card -->
      {plans.filter(p => p.id === 'titan').map(plan => (
  <div
    id="plan-titan"
    data-color={plan.accentColor}
    class="animate-on-scroll plan-card-container scroll-mt-32 max-w-7xl mx-auto cursor-pointer group/card"
    data-animation="fade-in-up"
    data-delay={360}
    onclick={`window.location.href='/plans/${plan.id}'`}
  >
    <article class="plan-card relative overflow-hidden rounded-[2rem] border-2 border-yellow-600/30 transition-all duration-700 group hover:border-yellow-500/60 hover:shadow-[0_0_80px_rgba(212,160,23,0.18)]">

      {/* BACKGROUNDS - more aggressive gradient */}
      <div class="absolute inset-0 bg-gradient-to-br from-yellow-900/10 via-[#08080c] to-[#08080c]"></div>

      {/* Diagonal tech pattern */}
      <div class="absolute inset-0 opacity-[0.04] pointer-events-none" 
           style="background-image: repeating-linear-gradient(45deg, transparent, transparent 25px, rgba(212,160,23,0.04) 25px, rgba(212,160,23,0.04) 26px)"></div>

      {/* Corner accent */}
      <div class="absolute top-0 right-0 w-24 h-24 pointer-events-none overflow-hidden">
        <div class="absolute top-0 right-0 w-[140px] h-[2px] origin-top-right rotate-45 translate-x-1/2 bg-yellow-500/30"></div>
      </div>

      <div class="absolute inset-0 bg-gradient-to-r from-transparent via-yellow-500/[0.06] to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>

      <div
        class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700"
        style={`background: radial-gradient(800px circle at var(--mouse-x, 50%) var(--mouse-y, 50%), ${plan.accentColor}20, transparent 60%)`}
      ></div>

      <div class="absolute top-0 left-0 right-0 h-[1.5px] bg-gradient-to-r from-transparent via-yellow-500/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

      <div
        class="absolute -top-40 -right-40 w-[500px] h-[500px] opacity-[0.06] blur-[150px] rounded-full pointer-events-none transition-all duration-700 group-hover:opacity-25 group-hover:scale-150"
        style={{ backgroundColor: plan.accentColor }}
        aria-hidden="true"
      ></div>

      <div class="absolute -bottom-40 -left-40 w-[400px] h-[400px] opacity-[0.03] blur-[120px] rounded-full pointer-events-none group-hover:opacity-15 transition-all duration-700"
        style={{ backgroundColor: plan.accentColor }}
        aria-hidden="true"
      ></div>

      {/* CONTENT */}
      <div class="relative z-10 p-6 md:p-8 lg:p-10">

        {/* TOP SECTION */}
